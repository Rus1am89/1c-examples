////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: ЗагрузкаФайловНаДискБитрикс24
// Модуль управляемой формы
////////////////////////////////////////////////////////////////////////////////

// Адрес выбранного файла во временном хранилище.
// Хранится в клиентской переменной модуля формы — не виден в реквизитах,
// автоматически очищается при закрытии формы.
&НаКлиенте
Перем КлАдресФайлаВХранилище;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Подсказки в пустых полях
	Если ПустаяСтрока(Объект.АдресПортала) Тогда
		Объект.АдресПортала = "ваш_портал.bitrix24.ru";
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.КодВебхука) Тогда
		Объект.КодВебхука = "/rest/1/xxxxxxxxxxxxxxxx/";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьДиалогВыбораФайла();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайл(Команда)
	ОткрытьДиалогВыбораФайла();
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	Если ПустаяСтрока(КлАдресФайлаВХранилище) Тогда
		ПоказатьПредупреждение(, "Сначала выберите файл (нажмите ""..."" в поле ""Путь к файлу"").");
		Возврат;
	КонецЕсли;
	
	Если Не ПроверитьЗаполнениеНастроек() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = ИмяФайлаИзПути(Объект.ПутьКФайлу);
	ДобавитьВЛог("Начало загрузки: " + ИмяФайла);
	
	Результат = ЗагрузитьНаСервере(КлАдресФайлаВХранилище, ИмяФайла);
	
	ДобавитьВЛог(Результат.Сообщение);
	
	Если Результат.Успех Тогда
		ПоказатьПредупреждение(, "Файл успешно загружен на Диск Битрикс24.");
	Иначе
		ПоказатьПредупреждение(, "Ошибка загрузки. Подробности в логе.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЛог(Команда)
	Объект.Лог = "";
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура ОткрытьДиалогВыбораФайла()
	
	// НачатьПомещениеФайла с ИнтерактивныйРежимВыбора = Истина показывает диалог
	// выбора файла и кладёт его во временное хранилище. Работает во всех клиентах.
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораИПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораИПомещенияФайла(ПомещенныйФайл, АдресВременногоХранилища, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныйФайл = Неопределено Тогда
		Возврат; // Пользователь нажал "Отмена"
	КонецЕсли;
	
	Попытка
		Если ТипЗнч(ПомещенныйФайл) = Тип("Структура")
			ИЛИ ТипЗнч(ПомещенныйФайл) = Тип("ОписаниеПомещенногоФайла") Тогда
			КлАдресФайлаВХранилище = ПомещенныйФайл.Хранение;
			Объект.ПутьКФайлу      = ПомещенныйФайл.Имя;
		Иначе
			КлАдресФайлаВХранилище = АдресВременногоХранилища;
			Объект.ПутьКФайлу      = ВыбранноеИмяФайла;
		КонецЕсли;
	Исключение
		ДобавитьВЛог("Не удалось разобрать результат выбора файла: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если ПустаяСтрока(КлАдресФайлаВХранилище) Тогда
		ДобавитьВЛог("Не получен адрес файла во временном хранилище.");
		Возврат;
	КонецЕсли;
	
	ДобавитьВЛог("Файл выбран: " + Объект.ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Функция ИмяФайлаИзПути(Путь)
	Поз1 = СтрНайти(Путь, "\", НаправлениеПоиска.СКонца);
	Поз2 = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	Поз = Макс(Поз1, Поз2);
	Если Поз > 0 Тогда
		Возврат Сред(Путь, Поз + 1);
	КонецЕсли;
	Возврат Путь;
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеНастроек()
	
	Если ПустаяСтрока(Объект.АдресПортала) Тогда
		ПоказатьПредупреждение(, "Укажите адрес портала (например, mycompany.bitrix24.ru)");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПустаяСтрока(Объект.КодВебхука) Тогда
		ПоказатьПредупреждение(, "Укажите код вебхука (вид: /rest/1/xxxxxxx/)");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(АдресВХранилище, ИмяФайла)
	
	ДД = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	// Сбрасываем во временный файл на сервере (наш загрузчик принимает путь)
	ВременныйПуть = ПолучитьИмяВременногоФайла();
	ДД.Записать(ВременныйПуть);
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Результат = Обработка.ЗагрузитьФайлНаДискБитрикс24(
			ВременныйПуть, ИмяФайла, Объект.АдресПортала, Объект.КодВебхука);
	Исключение
		Результат = Новый Структура("Успех, Сообщение, Результат",
			Ложь, "Исключение: " + ОписаниеОшибки(), Неопределено);
	КонецПопытки;
	
	Попытка
		УдалитьФайлы(ВременныйПуть);
	Исключение
		// игнор
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВЛог(Сообщение)
	Объект.Лог = Объект.Лог + ТекущаяДата() + " | " + Сообщение + Символы.ПС + Символы.ПС;
КонецПроцедуры

#КонецОбласти
