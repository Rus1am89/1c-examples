////////////////////////////////////////////////////////////////////////////////
// Внешняя обработка: ЗагрузкаФайловНаДискБитрикс24
// Модуль объекта
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Загружает произвольный файл на Диск Битрикс24 в корень общего хранилища.
//
// Параметры:
//   ПутьКФайлу     - Строка - полный путь к локальному файлу
//   ИмяФайла       - Строка - имя файла на Диске Битрикс24 (с расширением)
//   АдресПортала   - Строка - например "mycompany.bitrix24.ru" (без https://)
//   КодВебхука     - Строка - путь вида "/rest/1/xxxxxxxxxxxxxxxx/"
//
// Возвращаемое значение:
//   Структура с полями:
//     Успех     - Булево
//     Сообщение - Строка
//     Результат - Структура с данными загруженного файла или Неопределено
//
Функция ЗагрузитьФайлНаДискБитрикс24(ПутьКФайлу, ИмяФайла, АдресПортала, КодВебхука) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура("Успех, Сообщение, Результат", Ложь, "", Неопределено);
	
	// Нормализуем входные параметры один раз
	ЧистыйАдрес  = НормализоватьАдресПортала(АдресПортала);
	ЧистыйВебхук = НормализоватьКодВебхука(КодВебхука);
	
	Попытка
		
		// ===== Шаг 0. Определяем ID корневой папки общего диска =====
		ТекстОшибкиДиагностики = "";
		IDКорневойПапки = ПолучитьIDКорневойПапкиОбщегоДиска(
			ЧистыйАдрес, ЧистыйВебхук, ТекстОшибкиДиагностики);
		
		Если IDКорневойПапки = 0 Тогда
			ВозвращаемоеЗначение.Сообщение = "Не удалось получить ID корневой папки."
				+ Символы.ПС + "Причина: " + ТекстОшибкиДиагностики
				+ Символы.ПС + "Проверьте адрес портала, вебхук и его права (нужен раздел disk).";
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		// ===== Загрузка файла =====
		// Используем disk.folder.uploadfile с передачей данных в ТЕЛЕ POST 
		// (application/x-www-form-urlencoded), а не в URL — это снимает 414.
		// fileContent передаётся как массив Base64-частей (даже если часть одна).
		// Имя файла передаётся в data[NAME].
		
		ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
		РазмерФайла = ДвоичныеДанныеФайла.Размер();
		
		// Base64-кодирование. На 12-20 МБ Base64-строка займёт ~17-28 МБ.
		// Облачный Б24 в /rest/ принимает в теле POST до ~35 МБ, так что одного
		// чанка достаточно для файлов до 20 МБ.
		Base64Строка = Base64Строка(ДвоичныеДанныеФайла);
		Base64Строка = СтрЗаменить(Base64Строка, Символы.ВК, "");
		Base64Строка = СтрЗаменить(Base64Строка, Символы.ПС, "");
		Base64Строка = СтрЗаменить(Base64Строка, " ", "");
		
		// URL-кодирование Base64-строки для безопасной передачи в form-urlencoded.
		// "+" и "/" в Base64 — это спецсимволы для URL, их нужно экранировать.
		Base64URLEncoded = КодироватьСтроку(Base64Строка, СпособКодированияСтроки.КодировкаURL);
		ИмяURLEncoded   = КодироватьСтроку(ИмяФайла,     СпособКодированияСтроки.КодировкаURL);
		
		// Формируем тело POST-запроса
		// id передаём как form-field (а не в URL!), чтобы query string был минимальным
		ТелоПОСТ = "id=" + Формат(IDКорневойПапки, "ЧГ=")
			+ "&data[NAME]=" + ИмяURLEncoded
			+ "&fileContent[0]=" + ИмяURLEncoded
			+ "&fileContent[1]=" + Base64URLEncoded
			+ "&generateUniqueName=Y";
		
		ПутьЗапроса = ЧистыйВебхук + "disk.folder.uploadfile.json";
		
		Соединение = СоздатьHTTPСоединение(ЧистыйАдрес);
		Запрос = Новый HTTPЗапрос(ПутьЗапроса);
		Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Запрос.УстановитьТелоИзСтроки(ТелоПОСТ, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		
		Если Ответ.КодСостояния <> 200 Тогда
			ВозвращаемоеЗначение.Сообщение = "Загрузка не удалась. Код: "
				+ Ответ.КодСостояния + Символы.ПС
				+ "Ответ Битрикса: " + ТелоОтвета + Символы.ПС
				+ "Размер файла: " + РазмерФайла + " байт" + Символы.ПС
				+ "Размер Base64: " + СтрДлина(Base64Строка) + " символов" + Символы.ПС
				+ "Размер тела POST: " + СтрДлина(ТелоПОСТ) + " символов" + Символы.ПС
				+ "ID папки: " + IDКорневойПапки + Символы.ПС
				+ "Имя файла: " + ИмяФайла;
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		Результат = ПрочитатьJSONИзСтроки(ТелоОтвета);
		
		Если Результат.Свойство("error") Тогда
			ВозвращаемоеЗначение.Сообщение = "Битрикс вернул ошибку: " + ТелоОтвета;
			Возврат ВозвращаемоеЗначение;
		КонецЕсли;
		
		ВозвращаемоеЗначение.Успех = Истина;
		ВозвращаемоеЗначение.Сообщение = "Файл успешно загружен. ID на Диске: "
			+ ?(Результат.result.Свойство("ID"), Результат.result.ID, "?");
		ВозвращаемоеЗначение.Результат = Результат.result;
		
	Исключение
		ВозвращаемоеЗначение.Успех = Ложь;
		ВозвращаемоеЗначение.Сообщение = "Исключение: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получает ID корневой папки общего диска компании.
// В Битрикс24 у каждого хранилища (storage) есть корневая папка (folder).
// disk.folder.uploadfile принимает именно id ПАПКИ, не хранилища.
// Параметр ТекстОшибки заполняется при неудаче.
Функция ПолучитьIDКорневойПапкиОбщегоДиска(АдресПортала, КодВебхука, ТекстОшибки = "")
	
	Попытка
		ПутьЗапроса = КодВебхука + "disk.storage.getlist.json";
		Соединение = СоздатьHTTPСоединение(АдресПортала);
		Запрос = Новый HTTPЗапрос(ПутьЗапроса);
		Ответ = Соединение.Получить(Запрос);
	Исключение
		ТекстОшибки = "HTTP-запрос упал. Хост: """ + АдресПортала + """, путь: """ 
			+ ПутьЗапроса + """. Системная ошибка: " + ОписаниеОшибки();
		Возврат 0;
	КонецПопытки;
	
	Попытка
		Если Ответ.КодСостояния <> 200 Тогда
			ТекстОшибки = "HTTP " + Ответ.КодСостояния + ". Тело: "
				+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 500);
			Возврат 0;
		КонецЕсли;
		
		Результат = ПрочитатьJSONИзСтроки(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		
		Если Не Результат.Свойство("result") Тогда
			ТекстОшибки = "В ответе нет поля result. Тело: "
				+ Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 500);
			Возврат 0;
		КонецЕсли;
		
		Хранилища = Результат.result;
		Если Хранилища.Количество() = 0 Тогда
			ТекстОшибки = "Список хранилищ пуст (у вебхука нет доступа ни к одному диску)";
			Возврат 0;
		КонецЕсли;
		
		// Ищем общий диск компании по ENTITY_TYPE = "common" и берём ROOT_OBJECT_ID.
		// Если общего не нашли — берём ROOT_OBJECT_ID первого попавшегося.
		ROOTПодходящего = 0;
		Для Каждого Хранилище Из Хранилища Цикл
			Если Хранилище.Свойство("ENTITY_TYPE") И Хранилище.ENTITY_TYPE = "common" Тогда
				Если Хранилище.Свойство("ROOT_OBJECT_ID") Тогда
					ROOTПодходящего = Число(Хранилище.ROOT_OBJECT_ID);
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ROOTПодходящего = 0 И Хранилища[0].Свойство("ROOT_OBJECT_ID") Тогда
			ROOTПодходящего = Число(Хранилища[0].ROOT_OBJECT_ID);
		КонецЕсли;
		
		Если ROOTПодходящего = 0 Тогда
			ТекстОшибки = "В ответе нет поля ROOT_OBJECT_ID";
			Возврат 0;
		КонецЕсли;
		
		Возврат ROOTПодходящего;
		
	Исключение
		ТекстОшибки = "Ошибка разбора ответа: " + ОписаниеОшибки();
		Возврат 0;
	КонецПопытки;
	
КонецФункции

// Чистит адрес портала от схемы, путей, слешей и пробелов.
Функция НормализоватьАдресПортала(Адрес)
	Результат = СокрЛП(Адрес);
	Результат = СтрЗаменить(Результат, "https://", "");
	Результат = СтрЗаменить(Результат, "http://", "");
	// Отрезаем всё после первого слеша (на случай если ввели путь)
	ПозСлеш = СтрНайти(Результат, "/");
	Если ПозСлеш > 0 Тогда
		Результат = Лев(Результат, ПозСлеш - 1);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Гарантирует, что код вебхука начинается со слеша.
Функция НормализоватьКодВебхука(Вебхук)
	Результат = СокрЛП(Вебхук);
	Если Не СтрНачинаетсяС(Результат, "/") Тогда
		Результат = "/" + Результат;
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Результат, "/") Тогда
		Результат = Результат + "/";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СоздатьHTTPСоединение(Хост)
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
	Возврат Новый HTTPСоединение(Хост, 443, , , , 120, SSL);
КонецФункции

Функция ПрочитатьJSONИзСтроки(Строка)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Значение = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

#КонецОбласти
